# ==========================================
# Axent Production Environment Variables
# ==========================================

# ── Render Backend API Service (Production Engine) ──
VITE_BACKEND_URL=https://axent-b0wl.onrender.com
VITE_API_URL=https://axent-b0wl.onrender.com

# ── Supabase Cloud Database & Realtime (Required) ──
VITE_SUPABASE_URL=https://jswcwixeoilxuhbzojee.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ── AI Reasoning Engine (server-side only; configure in Vercel, never VITE_*) ──
GROQ_API_KEY=your_server_side_groq_api_key


# ── Server-only API credentials (Vercel Functions; NEVER prefix with VITE_) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SMTP_USER=your_sender_mailbox@example.com
SMTP_PASSWORD=your_rotated_smtp_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=CodeSpark 2026 Examination Authority
APP_PUBLIC_URL=https://your-production-axent-domain.example
APP_ALLOWED_ORIGINS=https://your-production-axent-domain.example

# Dedicated interactive terminal (frontend build-time WebSocket URL)
VITE_CODE_RUNNER_WS_URL=wss://terminal.axent.axiogen.in/ws/terminal

# Dedicated interactive terminal (Vercel server-only function variables)
CODE_RUNNER_URL=https://terminal.axent.axiogen.in
CODE_RUNNER_SECRET=use-the-same-long-random-secret-as-the-runner-vm
