{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/codespark/test-smtp",
      "destination": "/api/codespark/send-emails?action=test"
    },
    {
      "source": "/api/codespark/test-smtp/",
      "destination": "/api/codespark/send-emails?action=test"
    },
    {
      "source": "/api/codespark/proctor-status",
      "destination": "/api/codespark/proctor-event?action=status"
    },
    {
      "source": "/api/codespark/public-config",
      "destination": "/api/codespark/public-exam?action=config"
    },
    {
      "source": "/api/codespark/round2-live-code",
      "destination": "/api/codespark/round2-submissions?action=live-code"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
