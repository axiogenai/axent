# ==========================================
# Axent Project .gitignore
# Covers Frontend (React/Vite) & Backend (Django)
# ==========================================

# Dependencies
node_modules/
backend/venv/
venv/
env/
.venv/
ENV/

# Production Builds
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
build/
staticfiles/

# Python & Django
*.py[cod]
*$py.class
__pycache__/
backend/**/__pycache__/
backend/db.sqlite3
*.sqlite3
*.sqlite3-journal

# Environment variables & secrets
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated
.DS_Store
Thumbs.db
Desktop.ini
